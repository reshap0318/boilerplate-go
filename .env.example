# Server
APP_HOST=0.0.0.0
APP_PORT=8080
APP_URL=http://localhost:8080
APP_FE_URL=http://localhost:3000

# Gin release, debug
GIN_MODE=release

# Trusted Proxies (comma-separated IPs/CIDRs of your reverse proxy / load balancer).
# Empty = trust none: client IP is the socket address and X-Forwarded-For is ignored.
# Set this when running behind nginx/traefik/ALB, otherwise every client shares the proxy IP for rate limiting.
TRUSTED_PROXIES=

# CORS Allowed Origins (comma-separated or * for all).
# "*" sends a wildcard without Allow-Credentials; list explicit origins if the frontend needs credentials.
ALLOWED_ORIGINS=*

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=30
DB_CONN_MAX_IDLE_TIME_MIN=5

# Redis
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0

# JWT (RS256)
JWT_PRIVATE_KEY_PATH=private/keys/private.pem
JWT_PUBLIC_KEY_PATH=private/keys/public.pem
JWT_PASSPHRASE_PATH=private/keys/passphrase
JWT_EXPIRATION=24
JWT_REFRESH_EXPIRATION=168

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Email/SMTP (optional - for password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
